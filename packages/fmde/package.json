{
  "name": "@fmde-hub/fmde",
  "version": "0.1.0",
  "private": true,
  "description": "FMDE in TypeScript: the schema, decode/encode, topics, normalisation into the FMDEhub model and conformance (ATS) checks (no Vue)",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
