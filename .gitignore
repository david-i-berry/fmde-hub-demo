# --- Dependencies and build output ---
node_modules/
dist/
dev-dist/
*.tsbuildinfo
/out-tsc
/tmp

# --- Package-manager logs and leftovers ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

# --- Editors and OS ---
.idea/
.vscode/*
.DS_Store
Thumbs.db

# --- Secrets ---
# Never commit credentials (broker passwords, npm/GitHub tokens, keys).
# The committed .npmrc holds settings only; never put an auth token in it.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# --- AI assistant and agent files ---
# Kept out of the repo: they can carry local context, tool permissions, MCP server configs
# with tokens, or instructions that steer an AI agent (a supply-chain / prompt-injection route).
# Claude
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
# OpenAI Codex / generic agent instructions
.codex/
AGENTS.md
AGENT.md
# Google Gemini
.gemini/
GEMINI.md
# GitHub Copilot
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
.github/chatmodes/
.copilot/
