# Supply-chain hardening for every npm command run in this repo (local and CI).
# Only the public registry, over HTTPS.
registry=https://registry.npmjs.org/
# Never run package install scripts (preinstall/postinstall): the commonest route for a
# compromised package to run code on a developer machine or CI runner. None of our
# dependencies needs one (fsevents is optional and macOS-only).
ignore-scripts=true
# Record exact versions when adding a dependency, so upgrades are deliberate.
save-exact=true
# Refuse to install with a Node/npm outside the versions a package declares.
engine-strict=true
